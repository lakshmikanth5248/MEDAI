# Copy this file to backend/.env and fill in real values.
# start-all.ps1 / migrate-all.ps1 read THIS file and export the variables into
# every service's process environment - you only ever paste the Supabase
# connection string in one place.

# --- Supabase Postgres connection string ---
# Get this from Supabase dashboard: Project Settings -> Database -> Connection string (URI)
# Use the "Session pooler" or direct connection string, e.g.:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# --- Auth secrets (generate long random strings, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`) ---
JWT_SECRET=changeme-generate-a-long-random-secret
INTERNAL_SERVICE_SECRET=changeme-generate-a-different-long-random-secret

# --- Service ports (defaults shown, change only if you have port conflicts) ---
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
CLINICAL_SERVICE_PORT=5002
PRESCRIPTION_SERVICE_PORT=5003
PHARMACY_SERVICE_PORT=5004
BILLING_SERVICE_PORT=5005
NOTIFICATION_SERVICE_PORT=5006
CORE_SERVICE_PORT=5007

# --- Upstream URLs the gateway routes to (defaults match ports above) ---
AUTH_SERVICE_URL=http://127.0.0.1:5001
CLINICAL_SERVICE_URL=http://127.0.0.1:5002
PRESCRIPTION_SERVICE_URL=http://127.0.0.1:5003
PHARMACY_SERVICE_URL=http://127.0.0.1:5004
BILLING_SERVICE_URL=http://127.0.0.1:5005
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5006
CORE_SERVICE_URL=http://127.0.0.1:5007

# --- Frontend origin allowed by CORS at the gateway ---
FRONTEND_ORIGIN=http://localhost:5173
